{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug FastAPI Backend (Python)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "backend.main:app",
                "--reload",
                "--port",
                "8000"
            ],
            "jinja": true,
            "justMyCode": true
        },
        {
            "name": "Debug ML Training Pipeline",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/python_ml/train_rul_model.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Debug C++ Telemetry Engine (macOS LLDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/cpp_engine/telemetry_parser",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "Build & Run C++ Telemetry Engine (macOS)"
        }
    ]
}
