{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Setup macOS Python Virtual Environment",
            "type": "shell",
            "command": "python3 -m venv .venv && .venv/bin/pip install --upgrade pip && .venv/bin/pip install -r requirements.txt",
            "problemMatcher": []
        },
        {
            "label": "Train AeroTwin ML Models",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python python_ml/train_rul_model.py",
            "problemMatcher": []
        },
        {
            "label": "Build & Run C++ Telemetry Engine (macOS)",
            "type": "shell",
            "command": "clang++ -std=c++17 -O2 -Wall cpp_engine/telemetry_parser.cpp -o cpp_engine/telemetry_parser && ./cpp_engine/telemetry_parser",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Start FastAPI Digital Twin Backend",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/uvicorn backend.main:app --reload --port 8000",
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Launch Avionics Dashboard in Browser",
            "type": "shell",
            "command": "open frontend/index.html",
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: clang++ build active file",
            "command": "/usr/bin/clang++",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}